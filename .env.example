# Copy to .env.local. Never commit real values (.env* is gitignored, only this file is tracked).

# Backend base URL, including any /api/v1 prefix. Server-only: no NEXT_PUBLIC_ prefix,
# because the browser never calls the API. Every call goes through this Next server.
# In docker-compose this is the internal service address, e.g. http://api:5000/api/v1.
API_BASE_URL=http://localhost:5000/api/v1

# debug | info | warn | error | silent. Defaults to info in production, debug otherwise.
LOG_LEVEL=debug
